# Production site URL — used for canonical links, sitemap.xml, JSON-LD, and
# the Open Graph image. Also set as a Vercel project environment variable
# (Settings → Environment Variables) for Production — that value takes
# precedence over this file during Vercel's build.
NEXT_PUBLIC_SITE_URL=https://aiventralabs.vercel.app

# Free-tier form backend for the contact form (no server of our own to send
# email from, since this is a static export). Get an access key instantly,
# no signup, at https://web3forms.com — just enter the destination email.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=
